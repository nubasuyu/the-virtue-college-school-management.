generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================
enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum QuestionType {
  MCQ
  THEORY
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum GradingStatus {
  PENDING_REVIEW
  APPROVED
  FLAGGED
}

// ==========================================
// MODELS
// ==========================================
model Tenant {
  id             String   @id @default(uuid())
  name           String   @default("The Virtue College")
  shortName      String   @default("TVC")
  domain         String   @unique
  primaryColor   String   @default("#5C4033")
  secondaryColor String   @default("#FFFDD0")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users            User[]
  students         Student[]
  parents          Parent[]
  studentParents   StudentParent[]
  classes          Class[]
  subjects         Subject[]
  attendance       Attendance[]
  
  examQuestions    ExamQuestion[]
  examOptions      ExamOption[]
  examRubrics      ExamRubric[]
  examAttempts     ExamAttempt[]
  studentAnswers   StudentAnswer[]
  aiGradingLogs    AIGradingLog[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  isActive     Boolean  @default(true)
  
  biometricId  String?  @unique 
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classes             Class[]        @relation("ClassTeacher")
  schedule            Schedule[]
  assignment          Assignment[]
  borrowings          Borrowing[]
  announcements       Announcement[]
  parent              Parent? 
  attendances         Attendance[]
  reviewedGradingLogs AIGradingLog[] @relation("AIGradingReviewer")

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Student {
  id                String   @id @default(uuid())
  tenantId          String
  
  // 👇 PERSONAL INFO
  firstName         String
  lastName          String
  middleName        String?
  dateOfBirth       DateTime
  gender            String?
  nationality       String?
  religion          String?
  bloodGroup        String?
  photoUrl          String?
  
  // 👇 ACADEMIC INFO
  admissionNo       String   @unique
  currentClassId    String?
  enrollmentTerm    Int      @default(1)
  enrollmentSession String?
  previousSchool    String?
  dateOfAdmission   DateTime?
  
  // 👇 CONTACT & ADDRESS
  email             String?
  residentialAddress String?
  city              String?
  state             String?
  postalCode        String?
  country           String?
  
  // 👇 MEDICAL & EMERGENCY
  knownAllergies    String?  @db.Text
  chronicConditions String?  @db.Text
  emergencyContactName       String?
  emergencyContactPhone      String?
  emergencyContactRelationship String?
  
  // 👇 SYSTEM & BIOMETRIC
  biometricId       String?  @unique
  parentPin         String?
  passwordHash      String
  mediaConsent      Boolean  @default(false)
  termsAccepted     Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  currentClass    Class?            @relation("StudentCurrentClass", fields: [currentClassId], references: [id])
  classHistories  ClassHistory[]
  grades          Grade[]
  attendances     Attendance[]
  payments        Payment[]
  submission      Submission[]
  borrowings      Borrowing[]
  behaviorScores  BehaviorScore[]
  reportComments  ReportComment[]
  academicHistory AcademicHistory[]
  examAttempts    ExamAttempt[]
  
  // 👈 RELATIONS
  studentParents  StudentParent[]
  studentFees     StudentFee[]      // 👈 NEW: Relation to personalized fees
}

model StudentParent {
  id        String   @id @default(uuid())
  tenantId  String
  
  studentId String
  parentId  String
  isPrimary Boolean  @default(false)
  relation  String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([tenantId])
  @@index([studentId])
  @@index([parentId])
}

model Parent {
  id          String   @id @default(uuid())
  tenantId    String
  
  firstName   String
  lastName    String
  phone       String
  email       String?
  occupation  String?
  employer    String?
  
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentParents StudentParent[]

  @@index([tenantId])
  @@index([email])
}

model BehaviorScore {
  id        String @id @default(uuid())
  studentId String
  termId    String
  sessionId String

  attendance    Int @default(0)
  attentiveness Int @default(0)
  cooperation   Int @default(0)
  willingness   Int @default(0)
  labour        Int @default(0)
  leadership    Int @default(0)
  neatness      Int @default(0)
  politeness    Int @default(0)

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, termId, sessionId])
}

model ReportComment {
  id        String @id @default(uuid())
  studentId String
  termId    String
  sessionId String

  teacherComment     String?
  houseMasterComment String?
  principalComment   String?
  nextTermBegins     String?

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, termId, sessionId])
}

model Exam {
  id             String   @id @default(uuid())
  tenantId       String
  termId         String
  name           String
  assessmentType String
  subjectId      String
  classId        String
  date           DateTime
  totalMarks     Int      @default(100)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  isOnline        Boolean  @default(false)
  durationMins    Int?     
  shuffleOptions  Boolean  @default(false)

  term       Term           @relation(fields: [termId], references: [id])
  subject    Subject        @relation(fields: [subjectId], references: [id])
  class      Class          @relation(fields: [classId], references: [id])
  grades     Grade[]
  questions  ExamQuestion[]
  attempts   ExamAttempt[]
}

model Grade {
  id        String @id @default(uuid())
  tenantId  String
  examId    String
  studentId String
  termId    String

  mcqScore      Float   @default(0)
  theoryScore   Float   @default(0)
  marksObtained Int     @default(0)
  remarks       String?
  grade         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([examId, studentId])
}

model AcademicSession {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms           Term[]
  classHistories  ClassHistory[]
  academicHistory AcademicHistory[]
}

model Term {
  id        String   @id @default(uuid())
  tenantId  String
  sessionId String
  name      String
  number    Int
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(false)

  session       AcademicSession @relation(fields: [sessionId], references: [id])
  exams         Exam[]
  grades        Grade[]
  feeStructures FeeStructure[]
  schedule      Schedule[]
}

model ClassHistory {
  id        String   @id @default(uuid())
  studentId String
  classId   String
  sessionId String
  promoted  Boolean  @default(false)
  createdAt DateTime @default(now())

  student Student         @relation(fields: [studentId], references: [id])
  class   Class           @relation(fields: [classId], references: [id])
  session AcademicSession @relation(fields: [sessionId], references: [id])
}

model Class {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  section        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  classTeacherId String?

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  students        Student[]         @relation("StudentCurrentClass")
  classHistories  ClassHistory[]
  exams           Exam[]
  attendances     Attendance[]
  academicHistory AcademicHistory[]
  feeStructures   FeeStructure[]
  schedule        Schedule[]
  assignment      Assignment[]
  announcements   Announcement[]
  classTeacher    User?             @relation("ClassTeacher", fields: [classTeacherId], references: [id])
}

model Subject {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  exams      Exam[]
  schedule   Schedule[]
  assignment Assignment[]

  @@unique([tenantId, code])
}

model Attendance {
  id             String            @id @default(uuid())
  tenantId       String
  
  studentId      String?
  userId         String?
  classId        String?
  
  date           DateTime          @db.Date
  
  checkInTime    DateTime?
  checkOutTime   DateTime?
  
  status         AttendanceStatus  @default(ABSENT)
  
  biometricId    String?
  deviceName     String?
  notes          String?
  
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  student  Student? @relation(fields: [studentId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
  class    Class?   @relation(fields: [classId], references: [id])

  @@unique([studentId, date])
  @@unique([userId, date])
  @@index([tenantId, date])
  @@index([biometricId])
}

// 👇 UPDATED: Fee Structure with Optional flags
model FeeStructure {
  id          String    @id @default(uuid())
  tenantId    String?
  name        String
  amount      Float
  currency    String    @default("USD")
  classId     String
  termId      String?
  description String
  dueDate     DateTime?
  
  isOptional  Boolean   @default(false) // 👈 NEW: e.g., Hostel, Bus
  category    String    @default("TUITION") // 👈 NEW: TUITION, HOSTEL, BUS, etc.
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  class         Class          @relation(fields: [classId], references: [id])
  term          Term?          @relation(fields: [termId], references: [id])
  payments      Payment[]
  studentFees   StudentFee[]   // 👈 NEW RELATION
}

// 👇 NEW: Tracks exactly which fees apply to which specific student
model StudentFee {
  id             String   @id @default(uuid())
  studentId      String
  feeStructureId String
  amount         Float?   // If null, uses the default FeeStructure amount
  isWaived       Boolean  @default(false) // Admin can waive a fee for a specific student
  createdAt      DateTime @default(now())

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@unique([studentId, feeStructureId]) // A student can only have one record per fee type
}

model Payment {
  id             String   @id @default(uuid())
  tenantId       String
  studentId      String
  feeStructureId String?
  amount         Float
  currency       String   @default("USD")
  paymentDate    DateTime @default(now())
  paymentMethod  String
  reference      String?
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student       @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id])
}

model Schedule {
  id        String   @id @default(uuid())
  tenantId  String
  classId   String
  subjectId String
  teacherId String
  dayOfWeek String
  startTime String
  endTime   String
  roomName  String?
  termId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher User    @relation(fields: [teacherId], references: [id])
  term    Term?   @relation(fields: [termId], references: [id])
}

model AcademicHistory {
  id        String   @id @default(uuid())
  studentId String
  classId   String
  sessionId String
  status    String   @default("PROMOTED")
  createdAt DateTime @default(now())

  student Student         @relation(fields: [studentId], references: [id])
  class   Class           @relation(fields: [classId], references: [id])
  session AcademicSession @relation(fields: [sessionId], references: [id])

  @@index([studentId])
}

model Assignment {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String?
  subjectId   String
  classId     String
  teacherId   String
  dueDate     DateTime
  totalMarks  Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject      @relation(fields: [subjectId], references: [id])
  class       Class        @relation(fields: [classId], references: [id])
  teacher     User         @relation(fields: [teacherId], references: [id])
  submissions Submission[]
}

model Submission {
  id            String   @id @default(uuid())
  tenantId      String
  assignmentId  String
  studentId     String
  submittedAt   DateTime @default(now())
  content       String?
  marksObtained Int?
  feedback      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])
}

model Book {
  id            String   @id @default(uuid())
  tenantId      String
  title         String
  author        String
  isbn          String?
  publisher     String?
  publishedYear Int?
  category      String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  copies BookCopy[]
}

model BookCopy {
  id         String   @id @default(uuid())
  tenantId   String
  bookId     String
  copyNumber Int
  status     String   @default("AVAILABLE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  book       Book        @relation(fields: [bookId], references: [id])
  borrowings Borrowing[]
}

model Borrowing {
  id           String    @id @default(uuid())
  tenantId     String
  bookCopyId   String
  studentId    String?
  userId       String?
  borrowerType String
  borrowedAt   DateTime  @default(now())
  dueDate      DateTime
  returnedAt   DateTime?
  fineAmount   Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookCopy BookCopy @relation(fields: [bookCopyId], references: [id])
  student  Student? @relation(fields: [studentId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])
}

model Announcement {
  id             String   @id @default(uuid())
  tenantId       String
  title          String
  content        String
  authorId       String
  targetAudience String   @default("ALL")
  targetClassId  String?
  isPinned       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author      User   @relation(fields: [authorId], references: [id])
  targetClass Class? @relation(fields: [targetClassId], references: [id])
}

model ExamQuestion {
  id           String        @id @default(uuid())
  tenantId     String
  examId       String
  type         QuestionType
  questionText String        @db.Text
  maxPoints    Float
  orderIndex   Int

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  exam         Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  options      ExamOption[]
  rubric       ExamRubric?
  answers      StudentAnswer[]

  @@index([examId])
  @@index([tenantId])
}

model ExamOption {
  id           String       @id @default(uuid())
  tenantId     String
  questionId   String
  optionText   String
  isCorrect    Boolean      @default(false)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  question     ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentAnswers StudentAnswer[]

  @@index([questionId])
}

model ExamRubric {
  id                String   @id @default(uuid())
  tenantId          String
  questionId        String   @unique
  modelAnswer       String   @db.Text
  gradingCriteria   Json     

  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  question          ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ExamAttempt {
  id              String        @id @default(uuid())
  tenantId        String
  examId          String
  studentId       String
  startTime       DateTime      @default(now())
  submitTime      DateTime?
  status          AttemptStatus @default(IN_PROGRESS)
  focusViolations Int           @default(0)

  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  exam            Exam          @relation(fields: [examId], references: [id])
  student         Student       @relation(fields: [studentId], references: [id])
  answers         StudentAnswer[]

  @@unique([examId, studentId])
  @@index([tenantId])
  @@index([studentId])
}

model StudentAnswer {
  id               String        @id @default(uuid())
  tenantId         String
  attemptId        String
  questionId       String
  selectedOptionId String?       
  submittedText    String?       @db.Text 
  autoGradeScore   Float         @default(0)
  lastSavedAt      DateTime      @default(now())

  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  attempt          ExamAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         ExamQuestion  @relation(fields: [questionId], references: [id])
  selectedOption   ExamOption?   @relation(fields: [selectedOptionId], references: [id])
  aiGradingLog     AIGradingLog?

  @@unique([attemptId, questionId])
}

model AIGradingLog {
  id                   String        @id @default(uuid())
  tenantId             String
  studentAnswerId      String        @unique
  aiSuggestedScore     Float?
  aiConfidence         Float?        
  aiFeedback           String?       @db.Text
  teacherFinalScore    Float?
  teacherFinalFeedback String?       @db.Text
  status               GradingStatus @default(PENDING_REVIEW)
  reviewedById         String?
  reviewedAt           DateTime?

  tenant               Tenant        @relation(fields: [tenantId], references: [id])
  studentAnswer        StudentAnswer @relation(fields: [studentAnswerId], references: [id], onDelete: Cascade)
  reviewedBy           User?         @relation("AIGradingReviewer", fields: [reviewedById], references: [id])

  @@index([tenantId])
  @@index([status])
}